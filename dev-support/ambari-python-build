set -euo pipefail

if [[ -n ${AMBARI_BUILD_PYTHON:-} ]]; then
  if command -v "$AMBARI_BUILD_PYTHON" >/dev/null 2>&1 \
      && "$AMBARI_BUILD_PYTHON" -c 'import sys; raise SystemExit(sys.implementation.name != "cpython" or sys.version_info < (3, 10))'; then
    exec "$AMBARI_BUILD_PYTHON" "$@"
  fi
  echo "AMBARI_BUILD_PYTHON must name a CPython 3.10+ interpreter" >&2
  exit 1
fi

for candidate in python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
  if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import sys; raise SystemExit(sys.implementation.name != "cpython" or sys.version_info < (3, 10))'; then
    exec "$candidate" "$@"
  fi
done

echo "A CPython 3.10+ build interpreter is required; set AMBARI_BUILD_PYTHON explicitly" >&2
exit 1
