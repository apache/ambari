{
  "HIVE": {
    "service": [],
    "HIVE_METASTORE": [
      {
        "name": "hive_metastore_process",
        "label": "Hive Metastore Process",
        "description": "This host-level alert checks whether the Hive Metastore accepts client connections.",
        "interval": 3,
        "scope": "ANY",
        "enabled": true,
        "source": {
          "type": "SCRIPT",
          "path": "BIGTOP/3.2.0/services/HIVE/package/alerts/alert_hive_metastore.py",
          "parameters": [
            {
              "name": "check.command.timeout",
              "display_name": "Command Timeout",
              "value": 60.0,
              "type": "NUMERIC",
              "description": "Maximum alert execution time",
              "units": "seconds",
              "threshold": "CRITICAL"
            }
          ]
        }
      },
      {
        "name": "hive_sys_db_status",
        "label": "Hive Sys Database",
        "description": "This alert checks whether the Hive sys database has been created.",
        "interval": 1,
        "scope": "ANY",
        "enabled": true,
        "source": {
          "type": "SCRIPT",
          "path": "BIGTOP/3.2.0/services/HIVE/package/alerts/alert_hive_sys_db.py",
          "parameters": []
        }
      }
    ],
    "HIVE_SERVER": [
      {
        "name": "hive_server_process",
        "label": "HiveServer2 Process",
        "description": "This host-level alert checks whether HiveServer2 accepts client requests.",
        "interval": 3,
        "scope": "ANY",
        "enabled": true,
        "source": {
          "type": "SCRIPT",
          "path": "BIGTOP/3.2.0/services/HIVE/package/alerts/alert_hive_thrift_port.py",
          "parameters": [
            {
              "name": "check.command.timeout",
              "display_name": "Command Timeout",
              "value": 60.0,
              "type": "NUMERIC",
              "description": "Maximum alert execution time",
              "units": "seconds",
              "threshold": "CRITICAL"
            },
            {
              "name": "default.smoke.user",
              "display_name": "Default Smoke User",
              "value": "ambari-qa",
              "type": "STRING",
              "description": "User used when cluster-env/smokeuser is absent",
              "visibility": "HIDDEN"
            },
            {
              "name": "default.smoke.principal",
              "display_name": "Default Smoke Principal",
              "value": "ambari-qa@EXAMPLE.COM",
              "type": "STRING",
              "description": "Principal used when cluster-env/smokeuser_principal_name is absent",
              "visibility": "HIDDEN"
            },
            {
              "name": "default.smoke.keytab",
              "display_name": "Default Smoke Keytab",
              "value": "/etc/security/keytabs/smokeuser.headless.keytab",
              "type": "STRING",
              "description": "Keytab used when cluster-env/smokeuser_keytab is absent",
              "visibility": "HIDDEN"
            }
          ]
        }
      }
    ]
  }
}
