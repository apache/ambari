{
  "name": "ats-hbase",
  "version": "1.0.0",
  "lifetime": "-1",
  "queue": {{yarn_hbase_service_queue_json}},
  "artifact": {
    "id": {{yarn_hbase_archive_id_json}},
    "type": "TARBALL"
  },
  "configuration": {
    "properties" : {
      "yarn.service.container-failure.retry.max" : 10,
      "yarn.service.framework.path" : {{yarn_service_framework_path_json}}
    },
    "env": {
      "HBASE_IDENT_STRING": "${USER}",
      "HBASE_LOG_DIR": "<LOG_DIR>",
      "HBASE_CONF_DIR": "$PWD/conf",
      "HBASE_PID_DIR": "$PWD/pids",
      "JAVA_HOME": {{java64_home_json}},
      "HBASE_ROOT_LOGGER": {{yarn_hbase_root_logger_json}},
      "SERVER_GC_OPTS": "-Xlog:gc*:file=${HBASE_LOG_DIR}/gc.log:time,uptime,level,tags:filecount=10,filesize=100M",
      "HBASE_OPTS": {{yarn_hbase_system_service_opts_json}},
      "HADOOP_HOME": "$PWD/lib/hadoop",
      "HADOOP_COMMON_HOME": "$PWD/lib/hadoop",
      "HADOOP_HDFS_HOME": "$PWD/lib/hadoop",
      "HADOOP_MAPRED_HOME": "$PWD/lib/hadoop",
      "HADOOP_YARN_HOME": "$PWD/lib/hadoop",
      "HADOOP_LIBEXEC_DIR": "$PWD/lib/hadoop/libexec",
      "HBASE_HOME": "$PWD/lib/hbase"
    },
    "files": [
      {
        "type": "TEMPLATE",
        "dest_file": "log4j.properties",
        "src_file": {{yarn_hbase_log4j_source_json}}
      },
      {
        "type": "TEMPLATE",
        "dest_file": "hbase-site.xml",
        "src_file": {{yarn_hbase_site_source_json}}
      },
      {
        "type": "TEMPLATE",
        "dest_file": "hbase-policy.xml",
        "src_file": {{yarn_hbase_policy_source_json}}
      },
      {
        "type": "STATIC",
        "dest_file": "hbase_grant_permissions.rb",
        "src_file": {{yarn_hbase_grant_source_json}}
      },
      {
        "type": "TEMPLATE",
        "dest_file": "core-site.xml",
        "src_file": {{yarn_hbase_core_site_source_json}}
      }
    ]
  },
  "components": [
    {
      "name": "master",
      "number_of_containers": {{yarn_hbase_master_containers}},
      "launch_command": "$HBASE_HOME/bin/hbase master start",
      "readiness_check": {
        "type": "HTTP",
        "properties": {
          "url": {{yarn_hbase_master_url_json}}
        }
      },
      "resource": {
        "cpus": {{yarn_hbase_master_cpu}},
        "memory": {{yarn_hbase_master_memory_json}}
      },
      "configuration": {
        "env": {
          "HBASE_LOG_PREFIX": "hbase-$HBASE_IDENT_STRING-master-$HOSTNAME",
          "HBASE_LOGFILE": "$HBASE_LOG_PREFIX.log",
          "HBASE_MASTER_OPTS": {{yarn_hbase_master_opts_json}}
        }
      },
      "placement_policy": {
        "constraints": [
          {
            "type": "ANTI_AFFINITY",
            "scope": "node",
            "target_tags": [
                  "master"
            ]
          }
        ]
      }
    },
    {
      "name": "regionserver",
      "number_of_containers": {{yarn_hbase_regionserver_containers}},
      "launch_command": "$HBASE_HOME/bin/hbase regionserver start",
      "readiness_check": {
        "type": "HTTP",
        "properties": {
          "url": {{yarn_hbase_regionserver_url_json}}
        }
      },
      "resource": {
        "cpus": {{yarn_hbase_regionserver_cpu}},
        "memory": {{yarn_hbase_regionserver_memory_json}}
      },
      "configuration": {
        "env": {
          "HBASE_LOG_PREFIX": "hbase-$HBASE_IDENT_STRING-regionserver-$HOSTNAME",
          "HBASE_LOGFILE": "$HBASE_LOG_PREFIX.log",
          "HBASE_REGIONSERVER_OPTS": {{yarn_hbase_regionserver_opts_json}}
        }
      },
      "placement_policy": {
        "constraints": [
          {
            "type": "ANTI_AFFINITY",
            "scope": "node",
            "target_tags": [
                  "regionserver"
            ]
          }
        ]
      }
    },
    {
      "name": "hbaseclient",
      "number_of_containers": {{yarn_hbase_client_containers}},
      "launch_command": {{yarn_hbase_client_launch_command_json}},
      "dependencies": [ "master", "regionserver" ],
      "resource": {
        "cpus": {{yarn_hbase_client_cpu}},
        "memory": {{yarn_hbase_client_memory_json}}
      },
      "configuration": {
        "env": {
          "HBASE_LOG_PREFIX": "hbase-$HBASE_IDENT_STRING-hbaseclient-$HOSTNAME",
          "HBASE_LOGFILE": "$HBASE_LOG_PREFIX.log"
        }
      },
      "placement_policy": {
        "constraints": [
          {
            "type": "ANTI_AFFINITY",
            "scope": "node",
            "target_tags": [
                  "hbaseclient"
            ]
          }
        ]
      }
    }
  ],
  "kerberos_principal" : {
    "principal_name" : {{yarn_ats_hbase_principal_json}},
    "keytab" : {{yarn_ats_hbase_keytab_uri_json}}
  }
}
