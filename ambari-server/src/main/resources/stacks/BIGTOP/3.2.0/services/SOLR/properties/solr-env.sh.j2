# By default the script will use JAVA_HOME to determine which java
# to use, but you can set a specific path for Solr to use without
# affecting other Java applications on your server/workstation.
SOLR_JAVA_HOME={{solr_java_home_assignment}}

# Increase Java Min/Max Heap as needed to support your indexing / query needs
SOLR_JAVA_MEM={{solr_java_mem_assignment}}

SOLR_JAVA_STACK_SIZE={{solr_java_stack_size_assignment}}

GC_LOG_OPTS={{solr_gc_log_opts_assignment}}
GC_TUNE={{solr_gc_tune_assignment}}

# Set the ZooKeeper connection string if using an external ZooKeeper ensemble
# e.g. host1:2181,host2:2181/chroot
# Leave empty if not using SolrCloud
ZK_HOST={{solr_zk_host_assignment}}

# Set the ZooKeeper client timeout (for SolrCloud mode)
ZK_CLIENT_TIMEOUT="60000"

# Use Ambari's verified agent hostname for the address exposed to cluster state
SOLR_HOST={{solr_rmi_hostname_assignment}}

# By default the start script uses UTC; override the timezone if needed
#SOLR_TIMEZONE="UTC"

# Set to true to activate the JMX RMI connector to allow remote JMX client applications
# to monitor the JVM hosting Solr; set to "false" to disable that behavior
# (false is recommended in production environments)
ENABLE_REMOTE_JMX_OPTS={{solr_jmx_enabled_assignment}}

# The script will use SOLR_PORT+10000 for the RMI_PORT or you can set it here
RMI_PORT={{solr_jmx_port_assignment}}

# Anything you add to the SOLR_OPTS variable will be included in the java
# start command line as-is, in ADDITION to other options. If you specify the
# -a option on start script, those options will be appended as well. Examples:
#SOLR_OPTS="$SOLR_OPTS -Dsolr.autoSoftCommit.maxTime=3000"
#SOLR_OPTS="$SOLR_OPTS -Dsolr.autoCommit.maxTime=60000"
#SOLR_OPTS="$SOLR_OPTS -Dsolr.clustering.enabled=true"
SOLR_RMI_HOST={{solr_rmi_hostname_assignment}}
SOLR_OPTS="$SOLR_OPTS -Djava.rmi.server.hostname=$SOLR_RMI_HOST"
{% if solr_extra_java_opts -%}
SOLR_EXTRA_JAVA_OPTS={{solr_extra_java_opts_assignment}}
SOLR_OPTS="$SOLR_OPTS $SOLR_EXTRA_JAVA_OPTS"
{% endif %}

# Location where the bin/solr script will save PID files for running instances
# If not set, the script will create PID files in $SOLR_TIP/bin
SOLR_PID_DIR={{solr_piddir_assignment}}

# Path to a directory where Solr creates index files, the specified directory
# must contain a solr.xml; by default, Solr will use server/solr
SOLR_HOME={{solr_datadir_assignment}}

# Solr provides a default Log4J configuration properties file in server/resources
# however, you may want to customize the log settings and file appender location
# so you can point the script to use a different log4j.properties file
LOG4J_PROPS={{solr_log4j_props_assignment}}

# Location where Solr should write logs to; should agree with the file appender
# settings in server/resources/log4j.properties
SOLR_LOGS_DIR={{solr_log_dir_assignment}}

# Sets the port Solr binds to, default is 8983
SOLR_PORT={{solr_port_assignment}}

# Be sure to update the paths to the correct keystore for your environment
{% if solr_ssl_enabled %}
SOLR_SSL_KEY_STORE={{solr_keystore_location_assignment}}
SOLR_SSL_KEY_STORE_PASSWORD={{solr_keystore_password_assignment}}
SOLR_SSL_TRUST_STORE={{solr_truststore_location_assignment}}
SOLR_SSL_TRUST_STORE_PASSWORD={{solr_truststore_password_assignment}}
SOLR_SSL_NEED_CLIENT_AUTH=false
SOLR_SSL_WANT_CLIENT_AUTH=false
{% endif %}

# Uncomment to set a specific SSL port (-Djetty.ssl.port=N); if not set
# and you are using SSL, then the start script will use SOLR_PORT for the SSL port
#SOLR_SSL_PORT=

{% if security_enabled -%}
SOLR_JAAS_FILE={{solr_jaas_file_assignment}}
SOLR_KERB_KEYTAB={{solr_web_kerberos_keytab_assignment}}
SOLR_KERB_PRINCIPAL={{solr_web_kerberos_principal_assignment}}
SOLR_HDFS_KERBEROS_OPTION={{solr_hdfs_kerberos_option_assignment}}
SOLR_KERBEROS_NAME_RULES_OPTION={{solr_kerberos_name_rules_assignment}}
SOLR_ZK_SECURITY_OPTS={{zk_security_opts_assignment}}
SOLR_OPTS="$SOLR_OPTS $SOLR_HDFS_KERBEROS_OPTION"
SOLR_OPTS="$SOLR_OPTS $SOLR_ZK_SECURITY_OPTS"

SOLR_AUTH_TYPE="kerberos"
SOLR_AUTHENTICATION_OPTS=" $SOLR_KERBEROS_NAME_RULES_OPTION -DauthenticationPlugin=org.apache.solr.security.KerberosPlugin -Djava.security.auth.login.config=$SOLR_JAAS_FILE -Dsolr.kerberos.principal=${SOLR_KERB_PRINCIPAL} -Dsolr.kerberos.keytab=${SOLR_KERB_KEYTAB} -Dsolr.kerberos.cookie.domain=${SOLR_HOST}"
{% endif %}
