<configuration supports_adding_forbidden="true">
  <property>
    <name>vmauth_http_port</name>
    <value>8427</value>
    <display-name>VMAUTH HTTP Port</display-name>
    <description>Stable Prometheus-compatible query and ingestion entry port.</description>
    <on-ambari-upgrade add="false"/>
  </property>
  <property>
    <name>require_authentication</name>
    <value>false</value>
    <display-name>Require VMAUTH Authentication</display-name>
    <description>Require Basic authentication at the unified VictoriaMetrics endpoint.</description>
    <value-attributes>
      <type>boolean</type>
    </value-attributes>
    <on-ambari-upgrade add="false"/>
  </property>
  <property>
    <name>api_username</name>
    <value></value>
    <display-name>API User</display-name>
    <description>Basic authentication user for the unified query and ingestion endpoint.</description>
    <on-ambari-upgrade add="false"/>
  </property>
  <property>
    <name>api_password</name>
    <value></value>
    <display-name>API Password</display-name>
    <property-type>PASSWORD</property-type>
    <value-attributes>
      <type>password</type>
      <hidden>CONFIG_DOWNLOAD</hidden>
    </value-attributes>
    <description>Basic authentication password. Generated VMAUTH configuration is restricted to mode 0600.</description>
    <on-ambari-upgrade add="false"/>
  </property>
</configuration>
