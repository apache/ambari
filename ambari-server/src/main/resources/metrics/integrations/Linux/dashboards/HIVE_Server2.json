  "uuid": 1717556321838575000,
  "configs": {
    "version": "3.0.0",
    "var": [],
    "panels": [
      {
        "type": "row",
        "id": "hive-sessions-row",
        "name": "Sessions and connections",
        "titleKey": "monitoring.dashboard.sections.hive.sessionsConnections",
        "collapsed": false,
        "layout": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0,
          "i": "hive-sessions-row",
          "isResizable": false
        },
        "panels": []
      },
      {
        "type": "stat",
        "id": "hive-sessions",
        "name": "Sessions",
        "description": "Open and active HiveServer2 sessions by host.",
        "version": "3.0.0",
        "datasourceCate": "prometheus",
        "datasourceValue": 1,
        "layout": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 1,
          "i": "hive-sessions",
          "isResizable": true
        },
        "targets": [
          {
            "refId": "A",
            "maxDataPoints": 240,
            "expr": "max by (host) (hive_server2_open_sessions{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"})",
            "legend": "open-{{host}}"
          },
          {
            "refId": "B",
            "maxDataPoints": 240,
            "expr": "max by (host) (hive_server2_active_sessions{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"})",
            "legend": "active-{{host}}"
          }
        ],
        "options": {
          "standardOptions": {}
        }
      },
      {
        "type": "stat",
        "id": "hive-connections",
        "name": "Open connections",
        "description": "Current open HiveServer2 connections by host.",
        "version": "3.0.0",
        "datasourceCate": "prometheus",
        "datasourceValue": 1,
        "layout": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 1,
          "i": "hive-connections",
          "isResizable": true
        },
        "targets": [
          {
            "refId": "A",
            "maxDataPoints": 240,
            "expr": "max by (host) (hive_server2_open_connections{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"})",
            "legend": "{{host}}"
          }
        ],
        "options": {
          "standardOptions": {}
        }
      },
      {
        "type": "stat",
        "id": "hive-connection-rate",
        "name": "Accepted connection rate",
        "description": "HiveServer2 connections accepted per second by host.",
        "version": "3.0.0",
        "datasourceCate": "prometheus",
        "datasourceValue": 1,
        "layout": {
          "h": 6,
          "w": 8,
          "x": 16,
          "y": 1,
          "i": "hive-connection-rate",
          "isResizable": true
        },
        "targets": [
          {
            "refId": "A",
            "maxDataPoints": 240,
            "expr": "sum by (host) (rate(hive_server2_connections_total{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"}[$__rate_interval]))",
            "legend": "{{host}}"
          }
        ],
        "options": {
          "standardOptions": {
            "util": "cps"
          }
        }
      },
      {
        "type": "row",
        "id": "hive-query-row",
        "name": "Queries",
        "titleKey": "monitoring.dashboard.sections.hive.queries",
        "collapsed": false,
        "layout": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 7,
          "i": "hive-query-row",
          "isResizable": false
        },
        "panels": []
      },
      {
        "type": "timeseries",
        "id": "hive-query-rate",
        "name": "Query throughput",
        "description": "Completed query observations, successes, and failures per second by host. A series appears after its first corresponding HiveServer2 event.",
        "version": "3.0.0",
        "datasourceCate": "prometheus",
        "datasourceValue": 1,
        "layout": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 8,
          "i": "hive-query-rate",
          "isResizable": true
        },
        "targets": [
          {
            "refId": "A",
            "maxDataPoints": 240,
            "expr": "sum by (host) (rate(hive_server2_submitted_queries_total{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"}[$__rate_interval]))",
            "legend": "observed-{{host}}"
          },
          {
            "refId": "B",
            "maxDataPoints": 240,
            "expr": "sum by (host) (rate(hive_server2_succeeded_queries_total{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"}[$__rate_interval]))",
            "legend": "succeeded/s-{{host}}"
          },
          {
            "refId": "C",
            "maxDataPoints": 240,
            "expr": "sum by (host) (rate(hive_server2_failed_queries_total{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"}[$__rate_interval]))",
            "legend": "failed/s-{{host}}"
          }
        ],
        "options": {
          "standardOptions": {
            "util": "reqps"
          }
        }
      },
      {
        "type": "barGauge",
        "id": "hive-async",
        "name": "Async executor",
        "description": "Current HiveServer2 async executor queue and pool sizes.",
        "version": "3.0.0",
        "datasourceCate": "prometheus",
        "datasourceValue": 1,
        "layout": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 8,
          "i": "hive-async",
          "isResizable": true
        },
        "targets": [
          {
            "refId": "A",
            "maxDataPoints": 240,
            "expr": "max by (host) (hive_server2_async_queue_size{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"})",
            "legend": "queued-{{host}}"
          },
          {
            "refId": "B",
            "maxDataPoints": 240,
            "expr": "max by (host) (hive_server2_async_pool_size{cluster=\"${cluster}\",service=\"HIVE\",component=\"HIVE_SERVER\"})",
            "legend": "workers-{{host}}"
          }
        ],
        "options": {
          "standardOptions": {}
        }
      },
      {
        "type": "row",
        "id": "hive-runtime-row",
        "name": "Runtime",
        "titleKey": "monitoring.dashboard.sections.hive.runtime",
        "collapsed": false,
        "layout": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 14,
          "i": "hive-runtime-row",
          "isResizable": false
        },
        "panels": []
      },
      {
